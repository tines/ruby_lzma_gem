#!/usr/bin/env ruby
# frozen_string_literal: true

# For local development console - loads the gem directly without going
# through Bundler's extension check (we compile via `rake compile`)
lib_path = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib_path) unless $LOAD_PATH.include?(lib_path)

# Check that the native extension is compiled
ext_path = File.join(lib_path, "lzma_sdk_wrapper", "lzma_sdk_wrapper.bundle")
ext_path = File.join(lib_path, "lzma_sdk_wrapper", "lzma_sdk_wrapper.so") unless File.exist?(ext_path)

unless File.exist?(ext_path)
  warn "Native extension not found. Please run: rake compile"
  exit 1
end

# Require ffi gem directly (our only runtime dependency)
require "ffi"

# Now load our gem from the local lib path
require "ruby_lzma"

# You can add fixtures and/or initialization code here to make experimenting
# with your gem easier. You can also use a different console, if you like.

require "irb"
IRB.start(__FILE__)
